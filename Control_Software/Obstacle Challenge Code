// Pin definitions
#define LEFT_TRIG_PIN 2
#define LEFT_ECHO_PIN 3
#define RIGHT_TRIG_PIN 4
#define RIGHT_ECHO_PIN 5
#define SERVO_PIN A0

#define MOTOR_A_PIN 10
#define MOTOR_A_DIR_PIN 12

#include <Servo.h>
#include <HUSKYLENS.h>
#include <Wire.h>

// HuskyLens object (note: class name is HUSKYLENS in all caps)
HUSKYLENS huskylens;

// Function prototypes
long readDistance(int trigPin, int echoPin);
void moveForward();
void moveBackward();
void stopMotor();
void turnServoAndMotor(int servoAngle, unsigned long duration);
int detectColor();
void handleColorDetection();
void handleUltrasonicSensors();

// Servo and timing constants
Servo myServo;

const int SERVO_CENTER = 92;
const int SERVO_SHARP_LEFT = 117;
const int SERVO_SHARP_RIGHT = 67;

// New mild turning angles (center ±21) for main loop operations only
// Higher angle for left (towards 117), lower for right (towards 67)
const int SERVO_MILD_LEFT = SERVO_CENTER + 24;   // 113 (gentler left)
const int SERVO_MILD_RIGHT = SERVO_CENTER - 24;  // 71 (gentler right)

// Delay variables (ms) - easily adjustable
const unsigned long DELAY_COLOR_DETECTION_PAUSE = 6000;
const unsigned long DELAY_CONTINUE_FORWARD_AFTER_DETECT = 1700;  // Forward time after detecting IDs 1/2
const unsigned long DELAY_PART2_TURN = 2000;  // Turn duration for IDs 1/2
const unsigned long DELAY_BACKWARD_AFTER_TURN = 6000;  // Backward time after turning for IDs 1/2
const unsigned long DELAY_PART2_BACKWARD = 3000;  // Kept (unused)
const unsigned long DELAY_PART1_BACKWARD = 700;  // Used for initial backward after detection in<< IDs 3/4
const unsigned long DELAY_PART1_TURN = 900;  // Turn duration for IDs 3/4 (used for both turns)
const unsigned long DELAY_ULTRASONIC_TURN = 900;
const unsigned long DELAY_OBSTACLE_PAUSE = 100;

const unsigned long ORIGINAL_TURN_DURATION = 900;
const unsigned long OPPOSITE_TURN_DURATION = 700;

const int ULTRASONIC_THRESHOLD_CM = 18;

int sequenceCount = 0;
const int maxSequences = 12;

bool colorDetectionPaused = false;
unsigned long colorDetectionPauseEndTime = 0;

// Motor speed control variable
int currentMotorSpeed = 120;  // default speed for setup operations

void setup() {
  Serial.begin(9600);  // Changed to 9600 baud
  delay(1000);  // Give time for Serial connection to stabilize

  Wire.begin();

  pinMode(LEFT_TRIG_PIN, OUTPUT);
  pinMode(LEFT_ECHO_PIN, INPUT);
  pinMode(RIGHT_TRIG_PIN, OUTPUT);
  pinMode(RIGHT_ECHO_PIN, INPUT);

  pinMode(MOTOR_A_PIN, OUTPUT);
  pinMode(MOTOR_A_DIR_PIN, OUTPUT);

  myServo.attach(SERVO_PIN);
  myServo.write(SERVO_CENTER); // Center servo

  stopMotor();  // Motor off at start

  Serial.println("=== SETUP STARTING ===");  // Debug print

  // --- Part: Original ultrasonic setup with MOTOR_SPEED = 100 ---
  // (Uses sharp angles as before)
  currentMotorSpeed = 120;  // Set speed to 100 for this part

  long leftDist = readDistance(LEFT_TRIG_PIN, LEFT_ECHO_PIN);
  long rightDist = readDistance(RIGHT_TRIG_PIN, RIGHT_ECHO_PIN);

  Serial.print("Initial left distance: ");
  Serial.print(leftDist);
  Serial.print(" cm, right distance: ");
  Serial.print(rightDist);
  Serial.println(" cm");



  // --- End of initial ultrasonic setup ---

  // Initialize HuskyLens for color detection
  Serial.println("Initializing HuskyLens...");
  if (!huskylens.begin(Wire)) {
    Serial.println("HuskyLens not detected. Check wiring. Continuing without color detection.");
    // Don't halt—continue to allow basic movement
  } else {
    Serial.println("HuskyLens detected.");
    huskylens.writeAlgorithm(ALGORITHM_COLOR_RECOGNITION);
  }

  // Set motor speed to slower for main loop
  currentMotorSpeed = 90;
  Serial.println("=== SETUP COMPLETE. Starting main loop. ===");
}

void loop() {
  // Check if max sequences reached
  if (sequenceCount >= maxSequences) {
    stopMotor();
    Serial.println("Max sequences reached. Stopping robot.");
    while (true) {
      delay(1000); // Halt here forever
    }
  }

  // Handle ultrasonic sensors continuously (always, even during pause)
  handleUltrasonicSensors();

  // Handle color detection and reactions
  handleColorDetection();

  delay(50);  // Small delay to prevent overwhelming the loop and sensors
}

// Reads distance in cm from ultrasonic sensor
long readDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 30000);
  if (duration == 0) return 999; // no echo

  return duration * 0.034 / 2;
}

void moveForward() {
  digitalWrite(MOTOR_A_DIR_PIN, LOW);  // Forward direction
  analogWrite(MOTOR_A_PIN, currentMotorSpeed);
}

void moveBackward() {
  digitalWrite(MOTOR_A_DIR_PIN, HIGH);  // Backward direction
  analogWrite(MOTOR_A_PIN, currentMotorSpeed);
}

void stopMotor() {
  analogWrite(MOTOR_A_PIN, 0);
}

// Turn servo and move forward for duration, then stop and center servo
void turnServoAndMotor(int servoAngle, unsigned long duration) {
  myServo.write(servoAngle);
  moveForward();
  delay(duration);
  stopMotor();
  myServo.write(SERVO_CENTER);
}

// Detect color using HuskyLens
// Returns:
// 0 = no color detected
// 1 = Orange
// 2 = Blue
// 3 = Red
// 4 = Green
int detectColor() {
  if (!huskylens.request()) {
    return 0;  // Fail silently if request fails
  }

  int blockCount = huskylens.available();
  if (blockCount == 0) {
    return 0; // No detected blocks
  }

  // Pick the block with the largest area (width * height)
  int maxArea = 0;
  int detectedColorID = 0;
  const int MIN_AREA_THRESHOLD = 500;  // Minimum area for confident detection (adjust as needed)

  for (int i = 0; i < blockCount; i++) {
    HUSKYLENSResult result = huskylens.read();  // Note: HUSKYLENSResult (all caps)

    int area = result.width * result.height;
    if (area > maxArea && area > MIN_AREA_THRESHOLD) {
      maxArea = area;
      detectedColorID = result.ID;
    }
  }

  if (detectedColorID >= 1 && detectedColorID <= 4) {
    Serial.print("Confident color detected: ID ");
    Serial.print(detectedColorID);
    Serial.print(", area: ");
    Serial.println(maxArea);
    return detectedColorID;
  }

  return 0;
}

void handleColorDetection() {
  // Always detect colors (even during pause for selective handling)
  int colorId = detectColor();

  // Check if pause is active (only affects IDs 1/2)
  if (colorDetectionPaused) {
    if (millis() >= colorDetectionPauseEndTime) {
      colorDetectionPaused = false;
      Serial.println("Color detection resumed.");
    } else {
      // During pause: Ignore only IDs 1/2 (treat as 0), but handle 3/4 normally
      if (colorId == 1 || colorId == 2) {
        Serial.println("Ignoring paused color ID (1 or 2). Continuing forward.");
        moveForward();
        return;
      }
      // For 3/4 during pause: Fall through to normal handling below
    }
  }

  if (colorId == 0) {
    // No color, move forward (this should happen most of the time)
    moveForward();
    return;
  }

  Serial.print("Handling color ID: ");
  Serial.println(colorId);

  if (colorId == 1 || colorId == 2) {
    sequenceCount++;
    Serial.print("Sequence count: ");
    Serial.println(sequenceCount);

    if (sequenceCount > maxSequences) {
      stopMotor();
      Serial.println("Max sequences reached. Stopping robot.");
      return;
    }

    // Continue forward briefly after detection
    Serial.println("Continuing forward after detection...");
    moveForward();
    delay(DELAY_CONTINUE_FORWARD_AFTER_DETECT);
    stopMotor();

    // Then perform the turn (using mild angles)
    if (colorId == 1) {
      Serial.println("Orange detected: Turning mild right.");
      turnServoAndMotor(SERVO_MILD_RIGHT, DELAY_PART2_TURN);
    } else if (colorId == 2) {
      Serial.println("Blue detected: Turning mild left.");
      turnServoAndMotor(SERVO_MILD_LEFT, DELAY_PART2_TURN);
    }

    // Now move backward after the turn
    Serial.println("Moving backward after turn...");
    moveBackward();
    delay(DELAY_BACKWARD_AFTER_TURN);
    stopMotor();

    // Apply pause: Ignore IDs 1/2 for 5000ms, but continue forward + ultrasonics (3/4 still handled)
    Serial.println("Applying color detection pause (IDs 1/2 only)...");
    colorDetectionPaused = true;
    colorDetectionPauseEndTime = millis() + DELAY_COLOR_DETECTION_PAUSE;
    return;  // During pause, forward + ultrasonics will handle movement
  }

  if (colorId == 3) {
    // Red: Stop, backward (800ms) right after detection, brief pause, then turn mild right (2000ms), then opposite (mild left, 2000ms), then forward
    Serial.println("Red detected: Backing up briefly after detection, pausing, turning mild right then left.");
    stopMotor();
    // Initial backward right after detection
    Serial.println("Moving backward after detection (Red).");
    moveBackward();
    delay(DELAY_PART1_BACKWARD);
    stopMotor();
    delay(DELAY_OBSTACLE_PAUSE);  // Brief pause after backward
    turnServoAndMotor(SERVO_MILD_RIGHT, DELAY_PART1_TURN);  // First turn: right
    turnServoAndMotor(SERVO_MILD_LEFT, DELAY_PART1_TURN);   // Opposite turn: left (same duration)
    moveForward();
    return;
  }

  if (colorId == 4) {
    // Green: Stop, backward (800ms) right after detection, brief pause, then turn mild left (2000ms), then opposite (mild right, 2000ms), then forward
    Serial.println("Green detected: Backing up briefly after detection, pausing, turning mild left then right.");
    stopMotor();
    // Initial backward right after detection
    Serial.println("Moving backward after detection (Green).");
    moveBackward();
    delay(DELAY_PART1_BACKWARD);
    stopMotor();
    delay(DELAY_OBSTACLE_PAUSE);  // Brief pause after backward
    turnServoAndMotor(SERVO_MILD_LEFT, DELAY_PART1_TURN);   // First turn: left
    turnServoAndMotor(SERVO_MILD_RIGHT, DELAY_PART1_TURN);  // Opposite turn: right (same duration)
    moveForward();
    return;
  }
}

void handleUltrasonicSensors() {
  long leftDist = readDistance(LEFT_TRIG_PIN, LEFT_ECHO_PIN);
  long rightDist = readDistance(RIGHT_TRIG_PIN, RIGHT_ECHO_PIN);

  if (leftDist < ULTRASONIC_THRESHOLD_CM) {
    Serial.print("Left obstacle at ");
    Serial.print(leftDist);
    Serial.println(" cm. Turning mild right.");
    stopMotor();
    delay(DELAY_OBSTACLE_PAUSE);
    turnServoAndMotor(SERVO_MILD_RIGHT, DELAY_ULTRASONIC_TURN);
    moveForward();
    return;
  }

  if (rightDist < ULTRASONIC_THRESHOLD_CM) {
    Serial.print("Right obstacle at ");
    Serial.print(rightDist);
    Serial.println(" cm. Turning mild left.");
    stopMotor();
    delay(DELAY_OBSTACLE_PAUSE);
    turnServoAndMotor(SERVO_MILD_LEFT, DELAY_ULTRASONIC_TURN);
    moveForward();
    return;
  }

  // No obstacles: move forward
  moveForward();
}

