#include <Servo.h>
#include <HUSKYLENS.h>
#include <Wire.h>

// Pin definitions
#define LEFT_TRIG_PIN 2
#define LEFT_ECHO_PIN 3
#define RIGHT_TRIG_PIN 4
#define RIGHT_ECHO_PIN 5
#define SERVO_PIN A0
#define MOTOR_A_PIN 10
#define MOTOR_A_DIR_PIN 12

// Constants
#define MAX_SEQUENCES 12
#define RESET_DELAY 2000
#define SHUTDOWN_DELAY 3000 
#define CENTER_POSITION 93
#define SERVO_HOME_POSITION 90
#define MOTOR_SPEED 180
#define MIN_SERVO_ANGLE 78
#define MAX_SERVO_ANGLE 108
#define SAFE_DISTANCE 42
#define STARTUP_DELAY 3000  // NEW: 3-second startup delay

// HuskyLens Color IDs
#define COLOR_ID1 1
#define COLOR_ID2 2

// Global variables
Servo myServo;
HUSKYLENS huskylens;
int sequenceCount = 0;
unsigned long sequenceStartTime = 0;
unsigned long shutdownStartTime = 0;
bool sequenceCompleted = false;
bool motorStopped = false;
bool shutdownSequenceStarted = false;
bool detectionPaused = false;
bool huskylensInitialized = false;

int currentServoAngle = CENTER_POSITION;

void setup() {
  Serial.begin(9600);
  
  // NEW: 3-second pause at startup
  Serial.println("=== Robot System Starting ===");
  Serial.println("Initializing in 3 seconds...");
  delay(STARTUP_DELAY);
  Serial.println("Starting initialization now!");
  
  // Setup hardware
  pinMode(LEFT_TRIG_PIN, OUTPUT);
  pinMode(LEFT_ECHO_PIN, INPUT);
  pinMode(RIGHT_TRIG_PIN, OUTPUT);
  pinMode(RIGHT_ECHO_PIN, INPUT);
  
  myServo.attach(SERVO_PIN);
  centerServo();
  
  pinMode(MOTOR_A_PIN, OUTPUT);
  pinMode(MOTOR_A_DIR_PIN, OUTPUT);
  startMotor();
  
  // Initialize HuskyLens
  Serial.println("Initializing HuskyLens...");
  Wire.begin();
  
  if (huskylens.begin(Wire)) {
    huskylensInitialized = true;
    Serial.println("✓ HuskyLens connected!");
    
    // Set to color recognition
    huskylens.writeAlgorithm(ALGORITHM_COLOR_RECOGNITION);
    delay(1000);
    
    Serial.println("✓ Color recognition mode activated");
    Serial.println("Show trained colors to activate servo sequences");
  } else {
    Serial.println("✗ HuskyLens failed - using ultrasonic only");
  }
  
  Serial.println("=== System Ready ===");
}

void loop() {
  // Shutdown check
  if (sequenceCount >= MAX_SEQUENCES && !motorStopped && !shutdownSequenceStarted) {
    Serial.println("=== MAXIMUM SEQUENCES REACHED ===");
    shutdownSequenceStarted = true;
    shutdownStartTime = millis();
    returnServoToHome();
  }
  
  if (shutdownSequenceStarted && !motorStopped) {
    if (millis() - shutdownStartTime >= SHUTDOWN_DELAY) {
      stopMotor();
    }
    return;
  }
  
  if (motorStopped) return;
  
  // Read ultrasonic sensors
  int leftDistance = getDistance(LEFT_TRIG_PIN, LEFT_ECHO_PIN);
  int rightDistance = getDistance(RIGHT_TRIG_PIN, RIGHT_ECHO_PIN);
  
  // COLOR DETECTION (HIGH PRIORITY)
  if (huskylensInitialized && !sequenceCompleted && !shutdownSequenceStarted && !detectionPaused) {
    processColorDetection();
  } 
  else if (sequenceCompleted && !shutdownSequenceStarted) {
    if (millis() - sequenceStartTime >= RESET_DELAY) {
      resetSequence();
    }
  }
  
  // ULTRASONIC AVOIDANCE (LOW PRIORITY)
  if (!sequenceCompleted) {
    updateServoWithUltrasonic(leftDistance, rightDistance);
  }
  
  delay(50);
}

void processColorDetection() {
  // Use the working method from our test
  if (huskylens.request() && huskylens.available()) {
    HUSKYLENSResult result = huskylens.read();
    
    Serial.print("✓ Color detected! ID: ");
    Serial.println(result.ID);
    
    if (result.ID == COLOR_ID1) {
      Serial.println(">>> ACTIVATING SEQUENCE: Servo to 78° <<<");
      handleColorDetection(true);
    } 
    else if (result.ID == COLOR_ID2) {
      Serial.println(">>> ACTIVATING SEQUENCE: Servo to 108° <<<");
      handleColorDetection(false);
    }
  }
}

void handleColorDetection(bool setToMinAngle) {
  sequenceCompleted = true;
  detectionPaused = true;
  sequenceStartTime = millis();
  
  if (setToMinAngle) {
    setServoToMinAngle();
  } else {
    setServoToMaxAngle();
  }
  
  sequenceCount++;
  Serial.print("Sequence progress: ");
  Serial.print(sequenceCount);
  Serial.print("/");
  Serial.println(MAX_SEQUENCES);
}

// Rest of your functions remain the same...
int getDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  long duration = pulseIn(echoPin, HIGH);
  int distance = duration * 0.034 / 2;
  return (distance > 200 || distance <= 0) ? 200 : distance;
}

void updateServoWithUltrasonic(int leftDistance, int rightDistance) {
  if (sequenceCompleted) return;
  if (leftDistance < SAFE_DISTANCE && rightDistance < SAFE_DISTANCE) {
    centerServo();
  } else if (leftDistance < SAFE_DISTANCE) {
    myServo.write(MIN_SERVO_ANGLE);
    currentServoAngle = MIN_SERVO_ANGLE;
  } else if (rightDistance < SAFE_DISTANCE) {
    myServo.write(MAX_SERVO_ANGLE);
    currentServoAngle = MAX_SERVO_ANGLE;
  } else {
    centerServo();
  }
}

void setServoToMinAngle() {
  Serial.println("SERVO: Moving to 78°");
  myServo.write(MIN_SERVO_ANGLE);
  currentServoAngle = MIN_SERVO_ANGLE;
  delay(300);
}

void setServoToMaxAngle() {
  Serial.println("SERVO: Moving to 108°");
  myServo.write(MAX_SERVO_ANGLE);
  currentServoAngle = MAX_SERVO_ANGLE;
  delay(300);
}

void centerServo() {
  myServo.write(CENTER_POSITION);
  currentServoAngle = CENTER_POSITION;
}

void returnServoToHome() {
  Serial.println("SERVO: Returning to 90° home");
  myServo.write(SERVO_HOME_POSITION);
  currentServoAngle = SERVO_HOME_POSITION;
}

void startMotor() {
  digitalWrite(MOTOR_A_DIR_PIN, LOW);
  analogWrite(MOTOR_A_PIN, MOTOR_SPEED);
}

void stopMotor() {
  analogWrite(MOTOR_A_PIN, 0);
  motorStopped = true;
}

void resetSequence() {
  Serial.println("=== RESETTING - Ready for next color ===");
  centerServo();
  sequenceCompleted = false;
  detectionPaused = false;
}
