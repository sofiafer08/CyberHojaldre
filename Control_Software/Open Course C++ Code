#include <Servo.h>
#include <HUSKYLENS.h>
#include <Wire.h>

// Pin definitions
#define LEFT_TRIG_PIN 2
#define LEFT_ECHO_PIN 3
#define RIGHT_TRIG_PIN 4
#define RIGHT_ECHO_PIN 5
#define SERVO_PIN A0
#define MOTOR_A_PIN 10
#define MOTOR_A_DIR_PIN 12
#define HUSKY_R_PIN A5
#define HUSKY_T_PIN A4

// Constants
#define COLOR_ID1 1  // Orange
#define COLOR_ID2 2  // Blue

#define SERVO_CENTER 92
#define SERVO_LEFT (SERVO_CENTER + 18)   // 110 degrees approx
#define SERVO_RIGHT (SERVO_CENTER - 18)  // 74 degrees approx

#define ULTRASONIC_THRESHOLD 45  // cm
#define MAX_COLOR_DETECTIONS 12
#define COLOR_TURN_DURATION_MS 900  // Duration to keep turning after color detection (900 ms)
#define FORWARD_MOVE_DURATION_MS 2500 // Duration to move forward after 12 detections

#define MOTOR_SPEED 210

Servo myServo;
HUSKYLENS huskylens;

int colorCount = 0;
int currentColorID = 0;  // 0 = none, 1 = orange, 2 = blue
unsigned long lastColorDetectionTime = 0;
unsigned long colorTurnEndTime = 0;
unsigned long forwardMoveEndTime = 0;
bool motorStopped = false;
bool forwardMoveInitiated = false;
bool isTurning = false;

void setup() {
  Serial.begin(9600);

  // Initialize HuskyLens first
  Serial.println("Initializing HuskyLens...");
  Wire.begin();
  if (huskylens.begin(Wire)) {
    Serial.println("✓ HuskyLens connected!");
    huskylens.writeAlgorithm(ALGORITHM_COLOR_RECOGNITION);
    delay(1000);
    Serial.println("✓ Color recognition mode activated");
  } else {
    Serial.println("✗ HuskyLens failed - using ultrasonic only");
  }

  Serial.println("System starting in 3 seconds...");
  delay(3000);

  // Setup pins
  pinMode(LEFT_TRIG_PIN, OUTPUT);
  pinMode(LEFT_ECHO_PIN, INPUT);
  pinMode(RIGHT_TRIG_PIN, OUTPUT);
  pinMode(RIGHT_ECHO_PIN, INPUT);

  myServo.attach(SERVO_PIN);
  myServo.write(SERVO_CENTER);

  pinMode(MOTOR_A_PIN, OUTPUT);
  pinMode(MOTOR_A_DIR_PIN, OUTPUT);
  digitalWrite(MOTOR_A_DIR_PIN, LOW);
  analogWrite(MOTOR_A_PIN, MOTOR_SPEED);
}

void loop() {
  if (motorStopped) return;

  unsigned long now = millis();

  // Handle servo turning state
  if (isTurning) {
    if (now >= colorTurnEndTime) {
      // Turn duration ended
      isTurning = false;
      myServo.write(SERVO_CENTER);  // Center servo after turn
    } else {
      // Still turning, skip color detection and ultrasonic
      return;
    }
  }

  // Handle forward move state
  if (forwardMoveInitiated) {
    if (now < forwardMoveEndTime) {
      myServo.write(SERVO_CENTER);
      // Motor already running forward at MOTOR_SPEED
      return;
    } else {
      // Forward move duration elapsed, stop motor
      Serial.println("Forward move completed. Stopping motor.");
      stopMotor();
      return;
    }
  }

  // Handle color detection with priority only if not turning
  if (!isTurning && huskylens.request() && huskylens.available()) {
    HUSKYLENSResult result = huskylens.read();
    if (result.ID == COLOR_ID1 || result.ID == COLOR_ID2) {
      Serial.print("Color detected ID: ");
      Serial.println(result.ID);

      currentColorID = result.ID;
      colorCount++;
      lastColorDetectionTime = now;  // Update last detection time

      if (currentColorID == COLOR_ID1) {
        myServo.write(SERVO_RIGHT);  // Turn right
        Serial.println("Turning servo RIGHT (Orange detected)");
      } else {
        myServo.write(SERVO_LEFT);   // Turn left
        Serial.println("Turning servo LEFT (Blue detected)");
      }

      // Start turn immediately, no delay
      colorTurnEndTime = now + COLOR_TURN_DURATION_MS;
      isTurning = true;

      if (colorCount >= MAX_COLOR_DETECTIONS) {
        Serial.println("Max color detections reached. Initiating forward move.");
        forwardMoveInitiated = true;
        forwardMoveEndTime = now + FORWARD_MOVE_DURATION_MS;
      }

      return;  // Skip ultrasonic processing this loop
    }
  }

  // If no color detection or turning, use ultrasonic sensors
  int leftDist = getDistance(LEFT_TRIG_PIN, LEFT_ECHO_PIN);
  int rightDist = getDistance(RIGHT_TRIG_PIN, RIGHT_ECHO_PIN);

  // Print distances for Serial Plotter
  Serial.print(leftDist);
  Serial.print("\t");
  Serial.println(rightDist);

  // Ultrasonic logic: turn servo accordingly
  if (leftDist < ULTRASONIC_THRESHOLD && rightDist >= ULTRASONIC_THRESHOLD) {
    myServo.write(SERVO_RIGHT);  // Turn right if obstacle on left
  } else if (rightDist < ULTRASONIC_THRESHOLD && leftDist >= ULTRASONIC_THRESHOLD) {
    myServo.write(SERVO_LEFT);   // Turn left if obstacle on right
  } else {
    myServo.write(SERVO_CENTER); // Go straight otherwise
  }

  delay(20);  // Small delay to avoid flooding sensor reads
}

int getDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  long duration = pulseIn(echoPin, HIGH, 30000);  // Timeout 30ms to avoid blocking
  if (duration == 0) return 200;  // No echo received
  int distance = duration * 0.034 / 2;
  if (distance <= 0 || distance > 200) return 200;
  return distance;
}

void stopMotor() {
  analogWrite(MOTOR_A_PIN, 0);
  motorStopped = true;
  Serial.println("Motor stopped.");
}
